{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:build",
    "check:build": "node tooling/check-build.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "quality": "tsc -b && eslint . && prettier --check . && vitest run --coverage",
    "preview": "vite preview",
    "contract:live": "node tooling/contract-live.ts",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "trace": "node tooling/trace.ts",
    "dev:local": "node tooling/dev-local.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@reduxjs/toolkit": "2.13.0",
    "@tanstack/react-query": "5.104.5",
    "acl-adlc": "file:../ACL-ADLC-V1/acl-adlc-6.11.49.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0",
    "react-redux": "9.3.0",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
